{
    "name": "Google Review",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 3850447,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "5707b4602553ed90"
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "data": {
                                "editable": "true"
                            },
                            "label": "Google Review Simulator"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "ai-tools:Ask",
            "version": 2,
            "parameters": {
                "model": "small",
                "makeConnectionId": 8621985
            },
            "mapper": {
                "input": "You are a professional multilingual Customer Relations AI for a restaurant. Your sole job is to write a direct reply to the customer's review in the exact same language they used.\n\nSTRICT MANDATE:\n1. DETECT LANGUAGE: Analyze the language used in the \"Comment\" text. You MUST reply to the customer using the EXACT SAME LANGUAGE they used. This system strictly supports 6 key languages:\n   - English (Reply in English)\n   - Indonesian / Malay (Reply in Indonesian or Malay based on their dialect)\n   - Korean (Reply in Korean)\n   - Japanese (Reply in Japanese)\n   - French (Reply in French)\n   - Chinese (Reply in Chinese - Mandarin). Never mix them.\n2. TONE: Polite, empathetic, and professional.\n3. LOGIC BY RATING:\n   - If Rating is 4 or 5: Thank them sincerely and invite them to visit again.\n   - If Rating is 1, 2, or 3: Apologize deeply for the bad experience and state that management will evaluate this immediately.\n\n[CUSTOMER DATA]\nCustomer Name: {{1.reviewer_name}}\nReview Rating: {{1.star_rating}}/5\nComment:{{1.comment}}\n\n[OUTPUT INSTRUCTION]\nOutput ONLY the direct reply text for the customer. Do not include any introductory phrases (like \"Here is the reply:\"), no pleasantries, and no quotation marks.\n\n\n"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "918a571d147707b8"
                },
                "restore": {
                    "parameters": {
                        "model": {
                            "mode": "chose",
                            "label": "SmallModel: gpt-5-nano. Reasoning: minimal. Efficiently handles long conversations and reasoning, delivering smart conclusions quickly",
                            "nested": []
                        },
                        "makeConnectionId": {
                            "data": {
                                "scoped": "true",
                                "connection": "ai-provider"
                            },
                            "label": "Make's AI Provider (default)"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "makeConnectionId",
                        "type": "account:ai-provider,openai-gpt-3,anthropic-claude,gemini-ai-q9zyjp,ai-agent-foundry-openai,ai-agent-foundry-non-openai,mistral-ai,cohere,groq,ai-agent-xai,amazon-bedrock,ai-agent-openai-compatible",
                        "label": "Connection",
                        "required": true
                    },
                    {
                        "name": "model",
                        "type": "select",
                        "label": "Model",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "input",
                        "type": "text",
                        "label": "Text",
                        "required": true
                    }
                ]
            }
        },
        {
            "id": 3,
            "module": "telegram:SendReplyMessage",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 9212098
            },
            "filter": {
                "name": "Hanya Ulasan Buruk",
                "conditions": [
                    [
                        {
                            "a": "{{1.star_rating}}",
                            "b": "3",
                            "o": "number:lessorequal"
                        }
                    ]
                ]
            },
            "mapper": {
                "text": "🚨 GLOBAL GOOGLE MAPS ALERT (SIMULATED) 🚨\n\n🧑 Reviewer: {{1.reviewer_name}}\n⭐ Rating:{{1.star_rating}} / 5\n💬 Review: \"{{1.comment}}\n\n🤖 AI Auto-Reply: {{2.answer}}\n",
                "chatId": "697378482",
                "parseMode": "",
                "replyMarkup": "",
                "messageThreadId": "",
                "replyToMessageId": "",
                "replyMarkupAssembleType": "reply_markup_enter"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "a4b64860e861e89a"
                },
                "restore": {
                    "expect": {
                        "parseMode": {
                            "label": "Empty"
                        },
                        "disableNotification": {
                            "mode": "chose"
                        },
                        "replyMarkupAssembleType": {
                            "label": "Enter the Reply Markup"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "telegram"
                            },
                            "label": "My Telegram Bot connection"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:telegram",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "chatId",
                        "type": "text",
                        "label": "Chat ID",
                        "required": true
                    },
                    {
                        "name": "text",
                        "type": "text",
                        "label": "Text",
                        "required": true
                    },
                    {
                        "name": "messageThreadId",
                        "type": "number",
                        "label": "Message Thread ID"
                    },
                    {
                        "name": "parseMode",
                        "type": "select",
                        "label": "Parse Mode",
                        "validate": {
                            "enum": [
                                "Markdown",
                                "HTML"
                            ]
                        }
                    },
                    {
                        "name": "disableNotification",
                        "type": "boolean",
                        "label": "Disable Notifications"
                    },
                    {
                        "name": "disableWebPagePreview",
                        "type": "boolean",
                        "label": "Disable Link Previews"
                    },
                    {
                        "name": "replyToMessageId",
                        "type": "number",
                        "label": "Original Message ID"
                    },
                    {
                        "name": "replyMarkupAssembleType",
                        "type": "select",
                        "label": "Enter/Assemble the Reply Markup Field",
                        "validate": {
                            "enum": [
                                "reply_markup_enter",
                                "reply_markup_assemble"
                            ]
                        }
                    },
                    {
                        "name": "replyMarkup",
                        "type": "text",
                        "label": "Reply Markup"
                    }
                ]
            }
        }
    ],
    "metadata": {
